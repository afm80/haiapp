rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // ---- أرقام الموبايل: وثيقة لكل رقم (المفتاح = الرمز الدولي + الرقم بدون +) ----
    // الرقم يُحجز لحساب واحد فقط، ولا يتغير بعد حفظه.

    // الرقم المكتوب في ملف المستخدم محجوز فعلاً لهذا الحساب (يُفحص بعد العملية نفسها)
    // phoneKey = الرمز الدولي + الرقم بدون + (مثل 9647701234567)، وphone = '+' + phoneKey
    function phoneClaimedAfter(d) {
      return d.phone is string
        && d.phoneKey is string
        && d.phoneKey.matches('^[0-9]{7,15}$')
        && d.phone == '+' + d.phoneKey
        && existsAfter(/databases/$(database)/documents/phones/$(d.phoneKey))
        && getAfter(/databases/$(database)/documents/phones/$(d.phoneKey)).data.uid == request.auth.uid;
    }

    // ---- أسماء المستخدمين (@username): وثيقة لكل اسم، بحث بالاسم الدقيق فقط ----
    function usernameClaimedAfter(d) {
      return d.username is string
        && d.username.matches('^[a-z][a-z0-9_]{3,23}$')
        && existsAfter(/databases/$(database)/documents/usernames/$(d.username))
        && getAfter(/databases/$(database)/documents/usernames/$(d.username)).data.uid == request.auth.uid;
    }

    match /usernames/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && name.matches('^[a-z][a-z0-9_]{3,23}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', '') == name;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /phones/{key} {
      allow get: if signedIn();
      // البحث عن جهات الاتصال على دفعات (10 كحد أقصى) لمنع سحب كل الأرقام
      allow list: if signedIn() && request.query.limit <= 10;
      allow create: if signedIn()
        && key.matches('^[0-9]{7,15}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneKey == key;
      // لا يُحرَّر الرقم إلا عند حذف الحساب نفسه
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    match /users/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 10;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('phoneVerified', false) == false
        && (!('phone' in request.resource.data) || phoneClaimedAfter(request.resource.data))
        && (!('username' in request.resource.data) || usernameClaimedAfter(request.resource.data));
      allow update: if signedIn() && request.auth.uid == uid
        && (!('username' in request.resource.data) || usernameClaimedAfter(request.resource.data))
        && (
          // تعديل عادي لا يمس الرقم
          !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['phone', 'phoneKey', 'phoneCountry', 'phoneVerified'])
          // أو أول حجز للرقم (يُمنع تغييره بعدها)
          || (!('phone' in resource.data)
              && request.resource.data.get('phoneVerified', false) == false
              && phoneClaimedAfter(request.resource.data))
        );
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // طلبات توثيق الرقم: ينشئها التطبيق فقط، ويقرؤها ويكمل التوثيق الخادم (Webhook)
    match /verifications/{code} {
      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{12}$')
        && request.resource.data.keys().hasOnly(['uid', 'phoneKey', 'country', 'claim', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.phoneKey.matches('^[0-9]{7,15}$')
        && request.resource.data.country.matches('^[0-9]{1,4}$')
        && request.resource.data.claim is bool
        && (request.resource.data.claim == true
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneKey
                == request.resource.data.phoneKey);
      allow read, update, delete: if false;
    }

    match /chats/{chatId} {
      allow read, update: if signedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants;

      match /messages/{msgId} {
        function isMember() {
          return request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }
        allow read: if signedIn() && isMember();
        allow create: if signedIn() && isMember()
          && request.resource.data.senderId == request.auth.uid;
        // المرسل يعدّل ويحذف رسائله
        allow update, delete: if signedIn() && isMember()
          && resource.data.senderId == request.auth.uid;
        // أي عضو يقدر يضيف نفسه لقائمة "قرأ" فقط
        allow update: if signedIn() && isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'deletedFor', 'reactions']);
      }
    }

    match /statuses/{id} {
      // تُقرأ فقط من أصحاب الصلاحية: صاحب الحالة وجهات اتصاله (visibleTo)
      allow read: if signedIn() && request.auth.uid in resource.data.visibleTo;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.visibleTo is list
        && request.resource.data.visibleTo.size() <= 5000
        && request.auth.uid in request.resource.data.visibleTo;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        (request.auth.uid in resource.data.visibleTo
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers']))
      );
    }

    match /calls/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.resource.data.callerId == request.auth.uid;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
  }
}
